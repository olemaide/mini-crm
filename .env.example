# Copy to .env.local and fill in. Every variable here is validated by src/env.ts,
# so a missing or malformed value fails the build rather than surfacing at runtime.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local development: run `pnpm db:start` and use the values it prints.
# Staging/production: Project Settings → API. Use the EU (Frankfurt) region —
# the whole product stores personal data and is sold into the DACH market.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bypasses Row Level Security. Server-side only — never expose to the browser,
# never commit a real value, and never add a NEXT_PUBLIC_ prefix to it.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# CI only
# ---------------------------------------------------------------------------
# Lets `pnpm build` run without production secrets. Never set this outside CI.
# SKIP_ENV_VALIDATION="true"

# ---------------------------------------------------------------------------
# Arriving in later phases — listed so the shape is known in advance
# ---------------------------------------------------------------------------
# RESEND_API_KEY=""            # Phase 1: invitations
# POLAR_ACCESS_TOKEN=""        # Phase 8: billing
# POLAR_WEBHOOK_SECRET=""      # Phase 8: webhook signature verification
# DATABASE_URL=""              # CI: direct connection for the RLS audit
